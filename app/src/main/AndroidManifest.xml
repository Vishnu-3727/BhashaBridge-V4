<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission the app asks for. Models, translation, recognition and speech are all
         on-device, so there is deliberately no INTERNET permission to request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".BhashaBridgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BhashaBridgeV4">
        <!--
          Portrait only. Phase 10 validation found the landscape layout unusable: the output card
          and the whole speech section fall below the fold with nothing to scroll, so the core
          result is unreachable. Locking the orientation removes that state; a responsive landscape
          layout is the real fix and is recorded as future work in docs/VALIDATION_REPORT.md.

          This does not weaken configuration-change handling — the app is still recreated on a
          locale change, and that path is verified to preserve state without reloading a model.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First run only, launched by MainActivity. Not exported: nothing outside the app has a
             reason to open the setup flow. -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>