<?xml version="1.0" encoding="utf-8"?>
<!--
  The v3.4.1 translation screen, rebuilt: logo, language bar with swap, input card, translate
  action, output card, and a full-screen loading overlay that covers the model load.

  Speech controls, the emergency overlay and the navigation drawer arrive in their own commits —
  this file grows with them rather than shipping dead views ahead of the code that drives them.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

<FrameLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Title ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/menuBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/appTitle"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_bhashabridge" />
        </RelativeLayout>

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/circle_accent" />

        <!-- ── Language bar ── -->
        <LinearLayout
            android:id="@+id/langBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_lang_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langSrc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/lang_english"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/swapBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_swap_btn"
                android:contentDescription="@string/cd_swap_languages"
                android:src="@drawable/ic_swap"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/langTgt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/lang_hindi"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── Input ── -->
        <TextView
            android:id="@+id/labelInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/label_english"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/inputText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints=""
                android:background="@null"
                android:fontFamily="sans-serif-light"
                android:gravity="top|start"
                android:hint="@string/hint_english"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="4"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <!-- ── Translate ── -->
        <Button
            android:id="@+id/translateButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_translate_btn"
            app:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="@string/btn_translate"
            android:textColor="@color/accent_on"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ── Output ── -->
        <TextView
            android:id="@+id/labelOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/label_hindi"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/bg_card_output"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-light"
                android:gravity="top|start"
                android:lineSpacingMultiplier="1.5"
                android:padding="14dp"
                android:text="@string/output_placeholder"
                android:textColor="@color/output_idle"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <!-- Shown only when the device has no Hindi voice data; tapping opens the installer. -->
        <TextView
            android:id="@+id/ttsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="4dp"
            android:text="@string/tts_voice_missing"
            android:textColor="@color/emergency_light"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- ── Speech ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/speech_mode"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <com.bhashabridge.app.ui.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:visibility="invisible" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/micPulse"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_mic_pulse"
                    android:visibility="invisible" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_mic_btn"
                    android:contentDescription="@string/cd_mic"
                    android:elevation="4dp"
                    android:enabled="false"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/accent_on" />
            </FrameLayout>

            <TextView
                android:id="@+id/micStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="@string/mic_tap_to_speak"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/emergencyButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_emergency_btn"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/btn_emergency"
                android:textColor="@color/emergency"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/overlay_emergency" />

    <!-- ══ Loading overlay — covers the ONNX session load ══ -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:elevation="10dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="240dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_bhashabridge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:text="@string/app_tagline"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/loadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif"
                android:text="@string/loading_initialising"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/loadingProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="220dp"
                android:layout_height="3dp"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:progressTint="@color/accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_accent" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.3"
                    android:background="@drawable/circle_accent" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:alpha="0.3"
                    android:background="@drawable/circle_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>

    <!-- ══ Navigation drawer ══ -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_drawer"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trayHistory"
            style="@style/DrawerItem"
            android:text="@string/menu_history" />

        <View style="@style/DrawerDivider" />

        <TextView
            android:id="@+id/trayLanguage"
            style="@style/DrawerItem"
            android:text="@string/menu_language" />

        <View style="@style/DrawerDivider" />

        <TextView
            android:id="@+id/trayAbout"
            style="@style/DrawerItem"
            android:text="@string/menu_about" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
