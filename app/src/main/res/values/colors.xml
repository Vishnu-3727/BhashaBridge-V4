<?xml version="1.0" encoding="utf-8"?>
<!--
  The v3.4.1 palette, carried over so V4 is visually identical: a permanently dark surface with one
  emerald accent. Defined as named tokens and actually used as such — v3.4.1 declared these here
  and then still wrote `Color.parseColor("#6EE7B7")` inline throughout MainActivity.
-->
<resources>
    <!-- Dark background palette -->
    <color name="bg_primary">#0D0D0D</color>
    <color name="bg_card">#1A1A1A</color>
    <color name="bg_card_output">#141E1A</color>
    <color name="bg_surface">#252525</color>
    <color name="bg_drawer">#111111</color>
    <color name="divider">#1E1E1E</color>
    <color name="divider_light">#2A2A2A</color>

    <!-- Text -->
    <color name="text_primary">#EEEEEE</color>
    <color name="text_secondary">#888888</color>
    <color name="text_muted">#555555</color>
    <color name="text_hint">#444444</color>
    <color name="text_disabled">#333333</color>
    <color name="text_faint">#3A3A3A</color>

    <!-- Accent — emerald green -->
    <color name="accent">#6EE7B7</color>
    <color name="accent_pressed">#4ACA96</color>
    <color name="accent_dim">#1E4A3A</color>
    <color name="accent_on">#0D0D0D</color>

    <!-- Output text states (v3.4.1's COLOR_OUTPUT_* constants) -->
    <color name="output_idle">#2D4A3E</color>
    <color name="output_streaming">#4A7A6A</color>
    <color name="output_result">#6EE7B7</color>

    <!-- Emergency -->
    <color name="emergency">#FF4444</color>
    <color name="emergency_light">#FF6666</color>
    <color name="emergency_bg">#1A0000</color>
    <color name="emergency_bg_dark">#110000</color>

    <!-- Status / nav bar -->
    <color name="status_bar">#0D0D0D</color>
</resources>
