<?xml version="1.0" encoding="utf-8"?>
<!--
  Label left, value right, on one baseline.

  The label is `wrap_content` and the value `weight=1` with end gravity, which is what stops the
  wrapping that made the first version unreadable: the value owns all the leftover width and is
  right-aligned, so nothing is ever pushed onto a second line by a long label. A value that genuinely
  cannot fit ellipsises rather than reflowing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:minHeight="30dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />
</LinearLayout>
